# Copie este arquivo para .streamlit/secrets.toml (mesma pasta) e preencha
# com os valores reais do seu projeto Supabase. NUNCA versione o
# secrets.toml de verdade — só este .example fica no repositório (o
# .gitignore já bloqueia "secrets.toml").
#
# No deploy no Render, NÃO se usa este arquivo: DATABASE_URL é configurada
# como variável de ambiente no painel do serviço (ver render.yaml) e
# database.py cai automaticamente para ela quando não há secrets.toml.

# Connection string do Supabase (Project Settings -> Database -> Connection
# string -> URI). Prefira a porta 6543 (pooler/pgbouncer) para ambientes com
# muitas conexões simultâneas; 5432 é a conexão direta. Única variável
# obrigatória — o tenant agora vem do login (tela inicial do app, tabela
# `usuarios`), não precisa mais ser fixado aqui.
DATABASE_URL = "postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# Opcional: só usado pelo orquestrador via linha de comando (main.py), que
# não passa pela tela de login. Se você só usa o app pelo navegador, pode
# apagar esta linha. Gere um UUID com: python -c "import uuid; print(uuid.uuid4())"
# TENANT_ID = "00000000-0000-0000-0000-000000000000"
